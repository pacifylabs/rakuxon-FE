# Public-safe values only. NEVER put a Cloudinary api key or secret in this repo.

# The Rakuxon API. Every catalogue read goes through it — universities, search
# and (soon) courses — so an empty or wrong value shows a site with no
# catalogue rather than an error.
#   local development : http://localhost:3001
#   deployed          : https://rakuxon-be.onrender.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
