tion":"Registration, login, token rotation and password reset"},{"name":"onboarding-links","description":"Tokenised student invitations"}],"servers":[],"components":{"securitySchemes":{"access-token":{"scheme":"bearer","bearerFormat":"JWT","type":"http","in":"header"}},"schemas":{"HealthDependenciesDto":{"type":"object","properties":{"database":{"type":"string","enum":["up","down"],"description":"Postgres reachability."}},"required":["database"]},"HealthResponseDto":{"type":"object","properties":{"status":{"type":"string","example":"ok"},"environment":{"type":"string","enum":["development","test","production"]},"version":{"type":"string","example":"a1b2c3d","description":"Commit the running build came from."},"uptimeSeconds":{"type":"number","example":42},"dependencies":{"$ref":"#/components/schemas/HealthDependenciesDto"}},"required":["status","environment","version","uptimeSeconds","dependencies"]},"RegisterAgencyDto":{"type":"object","properties":{"agencyName":{"type":"string","example":"Northwind Education","description":"Agency name."},"slug":{"type":"string","example":"northwind","description":"Subdomain label. Lowercase letters, digits and hyphens."},"email":{"type":"string","example":"ada@northwind.example"},"firstName":{"type":"string","example":"Ada"},"lastName":{"type":"string","example":"Lovelace"},"password":{"type":"string","example":"correct-horse-battery","minLength":8}},"required":["agencyName","slug","email","firstName","lastName","password"]},"Role":{"type":"string","enum":["platform_admin","agency_admin","counselor","institution_user","student"]},"AuthUserDto":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"email":{"type":"string","example":"ada@northwind.example"},"firstName":{"type":"string","example":"Ada"},"lastName":{"type":"string","example":"Lovelace"},"role":{"allOf":[{"$ref":"#/components/schemas/Role"}]},"tenantId":{"type":"string","format":"uuid","nullable":true,"description":"Null for a platform administrator."},"emailVerifiedAt":{"type":"string","format":"date-time","nullable":true,"description":"Null until the address is confirmed. Not a sign-in gate."}},"required":["id","email","firstName","lastName","role","tenantId","emailVerifiedAt"]},"AuthTokensDto":{"type":"object","properties":{"accessToken":{"type":"string","description":"Short-lived JWT. Send as `Authorization: Bearer <token>`."},"refreshToken":{"type":"string","description":"Opaque, single-use. Rotated on every refresh."},"expiresIn":{"type":"number","example":900,"description":"Access token lifetime in seconds."},"user":{"$ref":"#/components/schemas/AuthUserDto"}},"required":["accessToken","refreshToken","expiresIn","user"]},"RegisterStudentDto":{"type":"object","properties":{"email":{"type":"string","example":"ada@example.com"},"firstName":{"type":"string","example":"Ada"},"lastName":{"type":"string","example":"Lovelace"},"password":{"type":"string","example":"correct-horse-battery","minLength":8}},"required":["email","firstName","lastName","password"]},"LoginDto":{"type":"object","properties":{"email":{"type":"string","example":"ada@northwind.example"},"password":{"type":"string","example":"correct-horse-battery"}},"required":["email","password"]},"RefreshDto":{"type":"object","properties":{"refreshToken":{"type":"string","description":"The refresh token from the previous login or refresh."}},"required":["refreshToken"]},"RequestPasswordResetDto":{"type":"object","properties":{"email":{"type":"string","example":"ada@northwind.example"}},"required":["email"]},"ConfirmPasswordResetDto":{"type":"object","properties":{"token":{"type":"string","description":"The token from the reset link."},"password":{"type":"string","example":"a-brand-new-passphrase","minLength":8}},"required":["token","password"]},"ConfirmEmailVerificationDto":{"type":"object","properties":{"token":{"type":"string","description":"The token from the verification link."}},"required":["token"]},"SsoCallbackDto":{"type":"object","properties":{"code":{"type":"string","description":"Authorization code from the provider redirect."},"redirectUri":{"type":"string","description":"The redirect URI the code was issued against."}},"required":["code","redirectUri"]},"HighlightSegmentDto":{"type":"object","properties":{"text":{"type":"string","example":"Uni"},"match":{"type":"boolean","example":true,"description":"True where this segment matched the query."}},"required":["text","match"]},"SearchResultDto":{"type":"object","properties":{"type":{"type":"string","enum":["institution","course","article"]},"id":{"type":"string"},"slug":{"type":"string","description":"Route key. /universities/[slug], /courses/[slug], /resources/[slug]."},"name":{"type":"string","example":"University of Manchester"},"subtitle":{"type":"string","example":"Manchester, United Kingdom"},"countryCode":{"type":"string","example":"GB","description":"ISO 3166-1 alpha-2, for the flag."},"highlight":{"type":"array","items":{"$ref":"#/components/schemas/HighlightSegmentDto"}}},"required":["type","id","slug","name","highlight"]},"SearchResponseDto":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/SearchResultDto"}},"total":{"type":"number","description":"Total matches before the limit, so the UI can offer \"see all\"."}},"required":["items","total"]},"CountryCountDto":{"type":"object","properties":{"countryCode":{"type":"string","example":"GB"},"country":{"type":"string","example":"United Kingdom"},"institutions":{"type":"number","example":456}},"required":["countryCode","country","institutions"]},"CountryDto":{"type":"object","properties":{"code":{"type":"string","example":"GB"},"name":{"type":"string","example":"United Kingdom"},"isDestination":{"type":"boolean","description":"Whether the catalogue has universities here."},"flagEmoji":{"type":"string","example":"🇬🇧"}},"required":["code","name","isDestination","flagEmoji"]},"InstitutionSummaryDto":{"type":"object","properties":{"id":{"type":"string"},"slug":{"