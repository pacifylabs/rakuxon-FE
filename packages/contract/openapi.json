itation link","tags":["onboarding-links"]}},"/v1/onboarding-links/peek":{"post":{"description":"Lets a sign-up form show who the invitation is from and prefill the invitee email, before the student has set a password. Does not mark the link consumed.","operationId":"OnboardingLinksController_peek_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PeekOnboardingLinkDto"}}}},"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PeekedLinkDto"}}}},"401":{"description":"The link is not valid."}},"summary":"Look up an invitation without spending it","tags":["onboarding-links"]}},"/v1/onboarding-links/register":{"post":{"description":"The tenant and email come from the token, not the request body, so a client cannot choose which agency they join. Returns a session — no separate login step.","operationId":"OnboardingLinksController_register_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterViaOnboardingLinkDto"}}}},"responses":{"201":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthTokensDto"}}}},"401":{"description":"The link is not valid."},"409":{"description":"That email is already registered in this agency."}},"summary":"Redeem an invitation and create the account in one step","tags":["onboarding-links"]}},"/v1/onboarding-links/{id}":{"delete":{"operationId":"OnboardingLinksController_revoke_v1","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"204":{"description":""}},"security":[{"access-token":[]}],"summary":"Revoke an invitation link","tags":["onboarding-links"]}},"/v1/students/me":{"get":{"operationId":"StudentsController_getOwnProfile_v1","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StudentProfileDto"}}}}},"security":[{"access-token":[]}],"summary":"The caller's own applicant profile","tags":["students"]},"patch":{"description":"Every field is optional — a partial save is expected. `profileCompletedAt` is set once every field admission processing needs is present, and stays set afterwards.","operationId":"StudentsController_updateOwnProfile_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateStudentProfileDto"}}}},"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StudentProfileDto"}}}}},"security":[{"access-token":[]}],"summary":"Update the caller's own applicant profile","tags":["students"]}},"/v1/documents/upload-signature":{"post":{"description":"Creates a `pending_upload` record and returns everything the browser needs to POST the file straight to Cloudinary. The file never passes through this API.","operationId":"DocumentsController_getUploadSignature_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UploadSignatureRequestDto"}}}},"responses":{"201":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UploadSignatureDto"}}}}},"security":[{"access-token":[]}],"summary":"Get a signed Cloudinary upload for one document","tags":["documents"]}},"/v1/documents/{id}/confirm":{"post":{"operationId":"DocumentsController_confirm_v1","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConfirmDocumentUploadDto"}}}},"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentDto"}}}}},"security":[{"access-token":[]}],"summary":"Record that a signed upload actually completed","tags":["documents"]}},"/v1/documents":{"get":{"operationId":"DocumentsController_list_v1","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/DocumentDto"}}}}}},"security":[{"access-token":[]}],"summary":"The caller's own documents","tags":["documents"]}},"/v1/documents/{id}":{"delete":{"operationId":"DocumentsController_remove_v1","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"204":{"description":""}},"security":[{"access-token":[]}],"summary":"Delete one of the caller's own documents","tags":["documents"]}},"/v1/applications":{"post":{"description":"Does not require a completed profile yet — that gate applies at submit time.","operationId":"ApplicationsController_create_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateApplicationDto"}}}},"responses":{"201":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApplicationDto"}}}}},"security":[{"access-token":[]}],"summary":"Start a draft application to one course","tags":["applications"]},"get":{"operationId":"ApplicationsController_list_v1","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ApplicationDto"}}}}}},"security":[{"access-token":[]}],"summary":"The caller's own applications","tags":["applications"]}},"/v1/applications/{id}":{"get":{"operationId":"ApplicationsController_get_v1","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApplicationDto"}}}}},"security":[{"access-token":[]}],"summary":"One of the caller's own applications","tags":["applications"]}},"/v1/applications/{id}/documents/{documentId}":{"post":{"operationId":"ApplicationsController_attachDocument_v1","parameters":[{"name":"id",