{"openapi":"3.0.0","paths":{"/v1/health":{"get":{"description":"Returns build information and the reachability of each dependency. Always 200 so a load balancer can distinguish \"process is up\" from \"database is down\" by reading the body. Unauthenticated, because a probe has no credentials.","operationId":"HealthController_check_v1","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthResponseDto"}}}}},"summary":"Liveness and dependency check","tags":["health"]}},"/v1/auth/register":{"post":{"description":"Creates the tenant and its `agency_admin` in one transaction and returns a session. The tenant starts as `pending` until an administrator vets it.","operationId":"AuthController_register_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterAgencyDto"}}}},"responses":{"201":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthTokensDto"}}}},"409":{"description":"The subdomain is already taken."}},"summary":"Register an agency and its first administrator","tags":["auth"]}},"/v1/auth/login":{"post":{"description":"Returns the same message whether the address is unknown or the password is wrong, so the response cannot be used to discover which addresses are registered.","operationId":"AuthController_login_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginDto"}}}},"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthTokensDto"}}}},"401":{"description":"Credentials are not valid, or the account is inactive."}},"summary":"Exchange credentials for a token pair","tags":["auth"]}},"/v1/auth/refresh":{"post":{"description":"Refresh tokens are single-use. Presenting one that has already been rotated revokes every token in its family, because a replay and a stolen token are indistinguishable.","operationId":"AuthController_refresh_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshDto"}}}},"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthTokensDto"}}}},"401":{"description":"Token unknown, expired, or already used."}},"summary":"Rotate a refresh token","tags":["auth"]}},"/v1/auth/logout":{"post":{"description":"Idempotent: an unknown token succeeds rather than reporting whether it existed.","operationId":"AuthController_logout_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshDto"}}}},"responses":{"204":{"description":""}},"summary":"End the session behind a refresh token","tags":["auth"]}},"/v1/auth/me":{"post":{"operationId":"AuthController_me_v1","parameters":[],"responses":{"200":{"description":"The authenticated user."},"401":{"description":"Missing, invalid or expired bearer token."}},"security":[{"access-token":[]}],"summary":"The identity behind the current access token","tags":["auth"]}},"/v1/onboarding-links":{"post":{"description":"The URL is returned once and never again — only a hash is stored. The tenant comes from your token, not from the request body.","operationId":"OnboardingLinksController_issue_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/IssueOnboardingLinkDto"}}}},"responses":{"201":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OnboardingLinkDto"}}}},"403":{"description":"Only an agency admin or counselor may issue links."}},"security":[{"access-token":[]}],"summary":"Issue a student invitation link","tags":["onboarding-links"]}},"/v1/onboarding-links/consume":{"post":{"description":"Public, because the student has no account yet. Expired, revoked, already-used and unknown tokens all return the same message.","operationId":"OnboardingLinksController_consume_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConsumeOnboardingLinkDto"}}}},"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConsumedLinkDto"}}}},"401":{"description":"The link is not valid."}},"summary":"Redeem an invitation link","tags":["onboarding-links"]}},"/v1/onboarding-links/{id}":{"delete":{"operationId":"OnboardingLinksController_revoke_v1","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"204":{"description":""}},"security":[{"access-token":[]}],"summary":"Revoke an invitation link","tags":["onboarding-links"]}}},"info":{"title":"Rakuxon API","description":"Multi-tenant study-abroad platform API.\n\n**Tenancy.** The tenant is derived server-side from the bearer token or the request\nsubdomain. It is never a field the client sets — any request body containing one is\nrejected by the global validation pipe.\n\n**Testing here.** Call `POST /v1/auth/register` then `POST /v1/auth/login`, press\n*Authorize*, and paste the `accessToken`. It persists across reloads.","version":"1.0","contact":{}},"tags":[{"name":"health","description":"Liveness and dependency checks"},{"name":"auth","description":"Registration, login, token rotation and password reset"},{"name":"onboarding-links","description":"Tokenised student invitations"}],"servers":[],"components":{"securitySchemes":{"access-token":{"scheme":"bearer","bearerFormat":"JWT","type":"http","in":"header"}},"schemas":{"HealthDependenciesDto":{"type":"object","properties":{"database":{"type":"string","enum":["up","down"],"description":"Postgres reachability."}},"required":["database"]},"HealthResponseDto":{"type":"object","properties":{"status":{"type":"string","example":"ok"},"environment":{"type":"string","enum":["development","test","production"]},"version":{"type":"string","example":"a1b2c3d","description":"Commit the running build came from."},"uptimeSeconds":{"type":"number","example":42},"dependencies":{"$ref":"#/components/schemas/HealthDependenciesDto"}},"required":["status","environment","version","uptimeSeconds","dependencies"]},"RegisterAgencyDto":{"type":"object","properties":{"agencyName":{"type":"string","example":"Northwind Education","description":"Agency name."},"slug":{"type":"string","example":"northwind","description":"Subdomain label. Lowercase letters, digits and hyphens."},"email":{"type":"string","example":"ada@northwind.example"},"fullName":{"type":"string","example":"Ada Lovelace"},"password":{"type":"string","example":"correct-horse-battery","minLength":12}},"required":["agencyName","slug","email","fullName","password"]},"Role":{"type":"string","enum":["platform_admin","agency_admin","counselor","institution_user","student"]},"AuthUserDto":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"email":{"type":"string","example":"ada@northwind.example"},"fullName":{"type":"string","example":"Ada Lovelace"},"role":{"allOf":[{"$ref":"#/components/schemas/Role"}]},"tenantId":{"type":"string","format":"uuid","nullable":true,"description":"Null for a platform administrator."}},"required":["id","email","fullName","role","tenantId"]},"AuthTokensDto":{"type":"object","properties":{"accessToken":{"type":"string","description":"Short-lived JWT. Send as `Authorization: Bearer <token>`."},"refreshToken":{"type":"string","description":"Opaque, single-use. Rotated on every refresh."},"expiresIn":{"type":"number","example":900,"description":"Access token lifetime in seconds."},"user":{"$ref":"#/components/schemas/AuthUserDto"}},"required":["accessToken","refreshToken","expiresIn","user"]},"LoginDto":{"type":"object","properties":{"email":{"type":"string","example":"ada@northwind.example"},"password":{"type":"string","example":"correct-horse-battery"}},"required":["email","password"]},"RefreshDto":{"type":"object","properties":{"refreshToken":{"type":"string","description":"The refresh token from the previous login or refresh."}},"required":["refreshToken"]},"IssueOnboardingLinkDto":{"type":"object","properties":{"inviteeEmail":{"type":"string","example":"student@example.com","description":"Who the invitation is for."},"expiresInDays":{"type":"number","example":14,"minimum":1,"maximum":90,"description":"Days until the link expires. Defaults to 14."}},"required":["inviteeEmail"]},"OnboardingLinkDto":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"url":{"type":"string","description":"The full invitation URL. Shown once, at issue time — only a hash is stored, so it cannot be retrieved again."},"inviteeEmail":{"type":"string","example":"student@example.com"},"expiresAt":{"type":"string","format":"date-time"}},"required":["id","url","inviteeEmail","expiresAt"]},"ConsumeOnboardingLinkDto":{"type":"object","properties":{"token":{"type":"string","description":"The token from the invitation link."}},"required":["token"]},"ConsumedLinkDto":{"type":"object","properties":{"tenantId":{"type":"string","format":"uuid"},"inviteeEmail":{"type":"string","example":"student@example.com"}},"required":["tenantId","inviteeEmail"]}}}}