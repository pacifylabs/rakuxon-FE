{"openapi":"3.0.0","paths":{"/v1/health":{"get":{"description":"Returns build information and the reachability of each dependency. Always 200 so a load balancer can distinguish \"process is up\" from \"database is down\" by reading the body. Unauthenticated, because a probe has no credentials.","operationId":"HealthController_check_v1","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthResponseDto"}}}}},"summary":"Liveness and dependency check","tags":["health"]}},"/v1/auth/register":{"post":{"description":"Creates the tenant and its `agency_admin` in one transaction and returns a session. The tenant starts as `pending` until an administrator vets it.","operationId":"AuthController_register_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterAgencyDto"}}}},"responses":{"201":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthTokensDto"}}}},"409":{"description":"The subdomain is already taken."}},"summary":"Register an agency and its first administrator","tags":["auth"]}},"/v1/auth/register/student":{"post":{"description":"Creates the account under the shared house tenant and returns a session. For a student joining through an agency's invitation, use POST /onboarding-links/register instead.","operationId":"AuthController_registerStudent_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RegisterStudentDto"}}}},"responses":{"201":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthTokensDto"}}}},"409":{"description":"That email is already registered."}},"summary":"Register directly as a student, with no agency","tags":["auth"]}},"/v1/auth/login":{"post":{"description":"Returns the same message whether the address is unknown or the password is wrong, so the response cannot be used to discover which addresses are registered.","operationId":"AuthController_login_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LoginDto"}}}},"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthTokensDto"}}}},"401":{"description":"Credentials are not valid, or the account is inactive."}},"summary":"Exchange credentials for a token pair","tags":["auth"]}},"/v1/auth/refresh":{"post":{"description":"Refresh tokens are single-use. Presenting one that has already been rotated revokes every token in its family, because a replay and a stolen token are indistinguishable.","operationId":"AuthController_refresh_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshDto"}}}},"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthTokensDto"}}}},"401":{"description":"Token unknown, expired, or already used."}},"summary":"Rotate a refresh token","tags":["auth"]}},"/v1/auth/logout":{"post":{"description":"Idempotent: an unknown token succeeds rather than reporting whether it existed.","operationId":"AuthController_logout_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RefreshDto"}}}},"responses":{"204":{"description":""}},"summary":"End the session behind a refresh token","tags":["auth"]}},"/v1/auth/password-reset/request":{"post":{"description":"Always answers 204, whether or not the address has an account. Reporting which is which would make this an account-enumeration endpoint.","operationId":"AuthController_requestPasswordReset_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RequestPasswordResetDto"}}}},"responses":{"204":{"description":""}},"summary":"Request a password reset link","tags":["auth"]}},"/v1/auth/password-reset/confirm":{"post":{"description":"Single-use, and every existing session is revoked. If the reset was triggered by a compromise, leaving the attacker signed in would defeat the point.","operationId":"AuthController_confirmPasswordReset_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConfirmPasswordResetDto"}}}},"responses":{"204":{"description":""},"401":{"description":"The link is unknown, expired or already used."}},"summary":"Set a new password from a reset link","tags":["auth"]}},"/v1/auth/verify-email/resend":{"post":{"description":"A no-op if the address is already verified — never reports which.","operationId":"AuthController_resendEmailVerification_v1","parameters":[],"responses":{"204":{"description":""},"401":{"description":"Missing, invalid or expired bearer token."}},"security":[{"access-token":[]}],"summary":"Re-send the verification link to the signed-in user","tags":["auth"]}},"/v1/auth/verify-email/confirm":{"post":{"description":"Single-use. Unlike a password reset, existing sessions are left alone.","operationId":"AuthController_confirmEmailVerification_v1","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConfirmEmailVerificationDto"}}}},"responses":{"204":{"description":""},"401":{"description":"The link is unknown, expired or already used."}},"summary":"Confirm an email address from a verification link","tags":["auth"]}},"/v1/auth/sso/{provider}/callback":{"post":{"description":"Exchanges the authorization code server-side, so no client secret reaches a browser. An address the provider has not verified is refused, and an address that already has an account is linked rather than duplicated. SSO does not create tenants.","operationId":"AuthController_ssoCallback_v1","parameters":[{"name":"provider","required":true,"in":"path","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SsoCallbackDto"}}}},"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthTokensDto"}}}},"401":{"description":"Provider refused, address unverified, or no account."}},"summary":"Complete a single sign-on redirect","tags":["auth"]}},"/v1/auth/me":{"post":{"operationId":"AuthController_me_v1","parameters":[],"responses":{"200":{"description":"The authenticated user."},"401":{"description":"Missing, invalid or expired bearer token."}},"security":[{"access-token":[]}],"summary":"The identity behind the current access token","tags":["auth"]}},"/v1/catalogue/search":{"get":{"description":"One ranked list across all three. Returns nothing for a query under two characters, since a shorter one matches most of the catalogue.","operationId":"CatalogueController_search_v1","parameters":[{"name":"query","required":true,"in":"query","description":"What the visitor has typed so far.","schema":{"example":"un","type":"string"}},{"name":"limit","required":false,"in":"query","schema":{"minimum":1,"maximum":20,"default":7,"type":"number"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchResponseDto"}}}}},"summary":"Search universities, courses and guidance","tags":["catalogue"]}},"/v1/catalogue/countries":{"get":{"operationId":"CatalogueController_countries_v1","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CountryCountDto"}}}}}},"summary":"Destinations with a published institution count","tags":["catalogue"]}},"/v1/catalogue/countries/reference":{"get":{"operationId":"CatalogueController_referenceCountries_v1","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CountryDto"}}}}}},"summary":"Every country, for a form dropdown","tags":["catalogue"]}},"/v1/catalogue/institutions":{"get":{"description":"Filter by country and free text. Only published records are returned.","operationId":"CatalogueController_listInstitutions_v1","parameters":[{"name":"country","required":false,"in":"query","description":"ISO 3166-1 alpha-2.","schema":{"example":"GB","type":"string"}},{"name":"q","required":false,"in":"query","description":"Free text over name, acronyms and city.","schema":{"type":"string"}},{"name":"page","required":false,"in":"query","schema":{"minimum":1,"default":1,"type":"number"}},{"name":"limit","required":false,"in":"query","schema":{"minimum":1,"maximum":100,"default":24,"type":"number"}},{"name":"sort","required":false,"in":"query","schema":{"default":"name","type":"string","enum":["name","city"]}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InstitutionListDto"}}}}},"summary":"Browse universities","tags":["catalogue"]}},"/v1/catalogue/institutions/{slug}":{"get":{"operationId":"CatalogueController_institution_v1","parameters":[{"name":"slug","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Institution"}}}},"404":{"description":"No published university with that slug."}},"summary":"One university","tags":["catalogue"]}},"/v1/catalogue/articles":{"get":{"description":"Filterable by destination or tag. Cards only — bodies come from the detail route.","operationId":"CatalogueController_listArticles_v1","parameters":[{"name":"country","required":false,"in":"query","description":"ISO 3166-1 alpha-2.","schema":{"example":"GB","type":"string"}},{"name":"tag","required":false,"in":"query","description":"Single tag, matched exactly.","schema":{"type":"string"}},{"name":"page","required":false,"in":"query","schema":{"minimum":1,"default":1,"type":"number"}},{"